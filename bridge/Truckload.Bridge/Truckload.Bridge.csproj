<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Truckload.Bridge</RootNamespace>
    <AssemblyName>Truckload.Bridge</AssemblyName>
    <Version>1.0.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- RuntimeIdentifier is intentionally NOT pinned here so `dotnet build`/`dotnet test` work
         on any host OS. Release publishing passes -r win-x64 explicitly (see bridge/README.md
         and .github/workflows/release.yml). -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../shared/Truckload.Contracts/Truckload.Contracts.csproj" />
  </ItemGroup>

</Project>
