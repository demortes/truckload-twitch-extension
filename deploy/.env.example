# Domain this backend is reachable at, and the email cert-issuance notices go to.
DOMAIN=truckload.example.com
ACME_EMAIL=you@example.com

# GHCR owner/org that published the backend image, and the tag to run.
GHCR_OWNER=demortes
TAG=latest

# Database
POSTGRES_USER=truckload
POSTGRES_PASSWORD=change_me_to_something_secure

# Twitch Developer Console — Extensions -> your extension -> Settings
TWITCH_EXTENSION_CLIENT_ID=your_client_id_here
TWITCH_EXTENSION_SECRET=your_base64_secret_here
