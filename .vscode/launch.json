{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Dev Server",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "dev"],
            "cwd": "${workspaceFolder}/src",
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            "name": "Debug in Chrome",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/src",
            "sourceMaps": true,
            "sourceMapPathOverrides": {
                "webpack:///src/*": "${webRoot}/*"
            }
        },
        {
            "name": "Debug in Edge",
            "type": "msedge",
            "request": "launch",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/src",
            "sourceMaps": true
        },
        {
            "name": "Preview Build",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "preview"],
            "cwd": "${workspaceFolder}/src",
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            "name": "Run Worker (wrangler dev)",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run dev",
            "cwd": "${workspaceFolder}/worker"
        }
    ],
    "compounds": [
        {
            "name": "Dev + Chrome",
            "configurations": ["Launch Dev Server", "Debug in Chrome"],
            "stopAll": true,
            "preLaunchTask": ""
        },
        {
            "name": "Dev + Edge",
            "configurations": ["Launch Dev Server", "Debug in Edge"],
            "stopAll": true,
            "preLaunchTask": ""
        },
        {
            "name": "Full Stack (Worker + Frontend + Chrome)",
            "configurations": ["Run Worker (wrangler dev)", "Launch Dev Server", "Debug in Chrome"],
            "stopAll": true
        }
    ]
}
